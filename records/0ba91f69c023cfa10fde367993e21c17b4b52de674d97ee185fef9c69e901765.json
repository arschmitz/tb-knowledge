\" stroke=\"black\" paint-order=\"fill stroke markers\" d=\" M 459.86147126746414 51.63409261281818 L 648.675531129636 51.63409261281818 L 648.675531129636 95.73914152281817 L 459.86147126746414 95.73914152281817 L 459.86147126746414 51.63409261281818 Z\" stroke-miterlimit=\"10\" stroke-width=\"2.613632528\" stroke-dasharray=\"\"/></g><g><g/><text fill=\"black\" stroke=\"none\" font-family=\"sans-serif\" font-size=\"11pt\" font-style=\"normal\" font-weight=\"normal\" text-decoration=\"normal\" x=\"477.58516684796416\" y=\"79.40393822281817\" text-anchor=\"start\" dominant-baseline=\"alphabetic\" xml:space=\"preserve\">nsMsgLocalMailFolder</text></g><path fill=\"none\" stroke=\"none\"/><g><path fill=\"white\" stroke=\"black\" paint-order=\"fill stroke markers\" d=\" M 857.7386885869547 51.63409261281818 L 1109.1194140985406 51.63409261281818 L 1109.1194140985406 95.73914152281817 L 857.7386885869547 95.73914152281817 L 857.7386885869547 51.63409261281818 Z\" stroke-miterlimit=\"10\" stroke-width=\"2.613632528\" stroke-dasharray=\"\"/></g><g><g/><text fill=\"black\" stroke=\"none\" font-family=\"sans-serif\" font-size=\"11pt\" font-style=\"normal\" font-weight=\"normal\" text-decoration=\"normal\" x=\"875.4623841674547\" y=\"79.40393822281817\" text-anchor=\"start\" dominant-baseline=\"alphabetic\" xml:space=\"preserve\">nsCopyMessageStreamListener</text></g><path fill=\"none\" stroke=\"none\"/><g><path fill=\"white\" stroke=\"black\" paint-order=\"fill stroke markers\" d=\" M 1297.3325521009035 51.63409261281818 L 1433.5132730348528 51.63409261281818 L 1433.5132730348528 95.73914152281817 L 1297.3325521009035 95.73914152281817 L 1297.3325521009035 51.63409261281818 Z\" stroke-miterlimit=\"10\" stroke-width=\"2.613632528\" stroke-dasharray=\"\"/></g><g><g/><text fill=\"black\" stroke=\"none\" font-family=\"sans-serif\" font-size=\"11pt\" font-style=\"normal\" font-weight=\"normal\" text-decoration=\"normal\" x=\"1315.0562476814034\" y=\"79.40393822281817\" text-anchor