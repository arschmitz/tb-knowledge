>\n        <div id=\"description\" class=\"description\" hidden=\"hidden\">\n          <slot name=\"description\"></slot>\n        </div>\n      </details>\n    </template>\n\n    <tb-banner id=\"basic\">\n      <span slot=\"title\">Test banner</span>\n    </tb-banner>\n\n    <tb-banner id=\"collapsible\">\n      <span slot=\"title\">Collapsible banner</span>\n      <span slot=\"description\">Collapsible description</span>\n    </tb-banner>\n\n    <tb-banner id=\"expanded\" variant=\"danger\" expanded=\"true\">\n      <span slot=\"title\">Expanded banner</span>\n      <span slot=\"description\">Expanded description</span>\n    </tb-banner>\n  </body>\n</html>","title":"History 6029–6036 accepted source: mail/base/test/browser/widgets/files/tbBanner.xhtml:1","version":1,"visibility":"shared"}
