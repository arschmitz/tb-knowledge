hedulerMultiWindow.js","mail/components/inappnotifications/test/browser/browser_inAppNotificationSchedulerNoUi.js","mail/components/inappnotifications/test/browser/browser_inAppNotificationSchedulerPosition.js","mail/components/inappnotifications/test/browser/browser_inAppNotificationSchedulerTabPosition.js","mail/components/inappnotifications/test/browser/files/inAppNotificationManager.xhtml","mail/components/inappnotifications/test/browser/head.js","mail/components/inappnotifications/test/unit/test_notification_manager.js","mail/components/inappnotifications/test/unit/test_notification_manager_telemetry.js","mail/components/inappnotifications/test/unit/test_notification_opener.js","mail/components/inappnotifications/test/unit/xpcshell.toml"],"quotes":[{"id":"6f5fe3d1da79d68b81b19604200e2e227d608be1e77eed1523f13f075998df52","text":"      currentWindow.removeEventListener(\"activate\", handleUnload);"},{"id":"6f5fe3d1da79d68b81b19604200e2e227d608be1e77eed1523f13f075998df52","text":"      currentWindow.removeEventListener(\"resize\", callback);"},{"id":"6f5fe3d1da79d68b81b19604200e2e227d608be1e77eed1523f13f075998df52","text":"    currentWindow.addEventListener(\"activate\", callback);"},{"id":"6f5fe3d1da79d68b81b19604200e2e227d608be1e77eed1523f13f075998df52","text":"    currentWindow.addEventListener(\"resize\", debounceCallback);"}],"repository":"thunderbird","source":{"basis":"Quoted evidence supports the claim; its interpretation still needs current-source checks.","revision":"9606e60c42063c5e7870b7843ce1524e3119f125","sourceAt":"2025-04-01T16:45:23Z","type":"extraction"},"status":"supported","supersedes":[],"text":"Fixed waitForActive registers activate with callback and resize/MozUpdateWindowPos with debounceCallback. Its cleanup removes activate with handleUnload and resize/MozUpdateWindowPos with callback. These are different function objects, so the shown removal calls do not remove those installed listeners. A proposed focused lifecycle test should settle/cancel a wait, fire each old event and check that its callback/timer cannot run again. This is a static callback-identity gap, not a reproduced leak or claim all cleanup is absent. Full earlier D239335 discussion remains unavailable. This is a public source-only scoped investigation/test proposal, not an accepted new rule or executed failure.","title":"Notification scheduler cleanup uses different listener functions from registration","version":1,"visibility":"shared"}
