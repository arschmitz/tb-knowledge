{"at":"2026-10-07T04:17:10.193Z","id":"44f8cbc0a9297439244e84244d995738a6c95d5e26c7b8139451c3138f8325bd","kind":"evidence","paths":["mail/components/accountcreation/templates/accountHubEmailOutgoingFormTemplate.inc.xhtml"],"repository":"thunderbird","source":{"file":"mail/components/accountcreation/templates/accountHubEmailOutgoingFormTemplate.inc.xhtml","lineEnd":156,"lineStart":1,"originalEvidence":"64309e09ffd2cc6b38c99e9b1086a910e328e44a1f0fdc03f0cb619e75fe068a","privateDraft":"7d484bcca25cfc24bcc1ddf23c33d15d9759db8779422fd746a88b51642edcf9","public":true,"replaces":[],"revision":"0b93f0f7a926ed94c8a0646f18b6734ec7cc0f6d","sourceAt":"2026-10-05T22:44:59Z","type":"code-snapshot","url":"https://github.com/thunderbird/thunderbird-desktop/blob/0b93f0f7a926ed94c8a0646f18b6734ec7cc0f6d/mail/components/accountcreation/templates/accountHubEmailOutgoingFormTemplate.inc.xhtml#L1","validation":"Exact public Git source at the fixed comparison revision. Claims are static observations. No runtime, build, lint or live accessibility validation ran.","verified":true},"text":"# This Source Code Form is subject to the terms of the Mozilla Public\n# License, v. 2.0. If a copy of the MPL was not distributed with this\n# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n\n<html:template id=\"accountHubOutgoingEmailFormTemplate\" xmlns=\"http://www.w3.org/1999/xhtml\">\n  <form id=\"outgoingEmailForm\" class=\"account-hub-form\" slot=\"content\">\n    <div class=\"hub-body manual-form-body\">\n      <div class=\"form-row\">\n        <div>\n          <span data-l10n-id=\"account-hub-protocol-label\"></span>\n          <div class=\"selected-option\">\n            SMTP\n          </div>\n        </div>\n        <div class=\"expanded\">\n          <label for=\"outgoingHostname\"\n                 data-l10n-id=\"account-hub-result-hostname-label\"\n                 class=\"option-label\">\n          </label>\n          <div class=\"input-control\">\n            <input id=\"outgoingHostname\"\n                   type=\"text\"\n                   placeholder=\"mail.example.com\"\n                   required=\"required\"\n                   class=\"input-field manual-input\"\n                   aria-invalid=\"false\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-danger input-warning\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-success input-success\" />\n            <span id=\"outgoingHostnameErrorMessage\"\n                  class=\"input-error-message\"\n                  data-l10n-id=\"account-hub-hostname-error-text\">\n            </span>\n          </div>\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div>\n          <label for=\"outgoingPort\"\n                 data-l10n-id=\"account-hub-on-port-label\"\n                 class=\"option-label\">\n          </label>\n          <div class=\"input-control\">\n            <input id=\"outgoingPort\"\n                   min=\"1\"\n                   max=\"65535\"\n                   type=\"number\"\n                   placeholder=\"465\"\n                   required=\"required\"\n                   class=\"input-field number-input\"\n                   aria-invalid=\"false\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-danger input-warning\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-success input-success\" />\n            <span id=\"outgoingPortErrorMessage\"\n                  class=\"input-error-message\"\n                  data-l10n-id=\"account-hub-port-error-text\">\n            </span>\n          </div>\n        </div>\n        <div class=\"expanded\">\n          <account-hub-select id=\"outgoingConnectionSecurity\"\n              l10n-label-id=\"account-hub-ssl-label\"\n              l10n-error-id=\"account-hub-select-security-warning\"\n              flex=\"1\">\n            <option id=\"outgoingConnectionSecurityAutodetect\"\n                    data-l10n-id=\"account-hub-ssl-autodetect-option\"\n                    value=\"-1\"></option>\n            <option id=\"outgoingConnectionSecurityNoEncryption\"\n                    data-l10n-id=\"account-hub-ssl-noencryption-option\"\n                    selected=\"selected\"\n                    value=\"0\"></option>\n            <option id=\"outgoingConnectionSecurityStartTtls\"\n                    label=\"STARTTLS\"\n                    value=\"2\"></option>\n            <option id=\"outgoingConnectionSecuritySslTls\"\n                    label=\"SSL/TLS\"\n                    value=\"3\"></option>\n          </account-hub-select>\n        </div>\n      </div>\n      <div class=\"form-row responsive-row\">\n        <account-hub-select id=\"outgoingAuthMethod\"\n                l10n-label-id=\"account-hub-auth-label\"\n                flex=\"1\">\n            <option id=\"outgoingAuthMethodAutodetect\"\n                    data-l10n-id=\"account-hub-ssl-autodetect-option\"\n                    selected=\"selected\"\n                    value=\"0\">\n            </option>\n            <option id=\"outgoingAuthMethodNone\"\n                    data-l10n-id=\"account-hub-auth-no-authentication-option\"\n                    value=\"1\">\n            </option>\n            <option id=\"outgoingAuthMethodCleartext\"\n                    data-l10n-id=\"account-hub-ssl-cleartext-password-option\"\n                    value=\"3\">\n            </option>\n            <option id=\"outgoingAuthMethodEncrypted\"\n                    data-l10n-id=\"account-hub-ssl-encrypted-password-option\"\n                    value=\"4\">\n            </option>\n            <option id=\"outgoingAuthMethodKerbos\"\n                    label=\"Kerberos / GSSAPI\"\n                    value=\"5\">\n            </option>\n            <option id=\"outgoingAuthMethodNtlm\"\n                    label=\"NTLM\"\n                    value=\"6\">\n            </option>\n            <option id=\"outgoingAuthMethodOAuth2\"\n                    value=\"10\"\n                    hidden=\"hidden\"\n                    label=\"OAuth2\">\n            </option>\n        </account-hub-select>\n        <div class=\"expanded\">\n          <label for=\"outgoingUsername\"\n                 data-l10n-id=\"account-hub-result-username-label\"\n                 class=\"option-label\">\n          </label>\n          <div class=\"input-control\">\n            <input id=\"outgoingUsername\"\n                   type=\"text\"\n                   data-l10n-id=\"account-hub-email-input\"\n                   required=\"required\"\n                   class=\"username input-field manual-input\"\n                   aria-invalid=\"false\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-danger input-warning\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-success input-success\" />\n            <span id=\"outgoingUsernameErrorMessage\"\n                  class=\"input-error-message\"\n                  data-l10n-id=\"account-hub-username-error-text\">\n            </span>\n          </div>\n        </div>\n      </div>\n      <button id=\"advancedConfigurationOutgoing\"\n              type=\"button\"\n              class=\"button link-button link-button-sm align-self-end\"\n              data-l10n-id=\"account-hub-advanced-setup-button\">\n      </button>\n    </div>\n    <button type=\"submit\" hidden=\"hidden\"></button>\n  </form>\n</html:template>","title":"History 1218–1247 accepted source: mail/components/accountcreation/templates/accountHubEmailOutgoingFormTemplate.inc.xhtml:1","version":1,"visibility":"shared"}
