{"at":"2026-10-29T11:47:46.345249+00:00","id":"d08814ff71275b7593fd92721c54e81ec0bfdfa1681bd03da8044e5f6619869b","kind":"evidence","paths":["mail/base/test/browser/widgets/files/paneSplitter.xhtml"],"repository":"thunderbird","source":{"file":"mail/base/test/browser/widgets/files/paneSplitter.xhtml","lineEnd":222,"lineStart":1,"originalEvidence":"63b224ceb4c7a35e9aa012f47a73a5ff8597d29ea9372354f47f5cc3c32d815d","privateDraft":"13c8ac24647d35536b0ded7101fcca7b42ccf8a4b826b64e5545116f43bd3d5f","public":true,"replaces":[],"revision":"0b93f0f7a926ed94c8a0646f18b6734ec7cc0f6d","sourceAt":"2026-10-05T22:44:59Z","type":"code-snapshot","url":"https://github.com/thunderbird/thunderbird-desktop/blob/0b93f0f7a926ed94c8a0646f18b6734ec7cc0f6d/mail/base/test/browser/widgets/files/paneSplitter.xhtml#L1","validation":"Exact public Git source at the fixed comparison revision. Claims are static observations. No runtime, build, lint or live accessibility validation ran.","verified":true},"text":"<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n  <meta charset=\"utf-8\" />\n  <title>Test for the pane-splitter custom element</title>\n  <style>\n    html,\n    body {\n      margin: 0;\n      overflow: hidden;\n    }\n\n    hr[is=\"pane-splitter\"] {\n      margin: 0 -3px;\n      border: none;\n      z-index: 1;\n      cursor: ew-resize;\n      opacity: .4;\n      background-color: red;\n    }\n\n    #splitter3,\n    #splitter4,\n    #splitter6 {\n      margin: -3px 0;\n      cursor: ns-resize;\n    }\n\n    #horizontal-before {\n      display: grid;\n      grid-template-columns: minmax(auto, var(--splitter1-width)) 0 auto;\n      width: 500px;\n      height: 100px;\n      --splitter1-width: 200px;\n      position: absolute;\n      top: 0;\n      left: 0;\n    }\n\n    #horizontal-after {\n      display: grid;\n      grid-template-columns: auto 0 minmax(auto, var(--splitter2-width));\n      width: 500px;\n      height: 100px;\n      --splitter2-width: 200px;\n      position: absolute;\n      top: 110px;\n      left: 0;\n    }\n\n    #vertical-before {\n      display: inline-grid;\n      grid-template-rows: minmax(auto, var(--splitter3-height)) 0 auto;\n      width: 100px;\n      height: 500px;\n      --splitter3-height: 200px;\n    }\n\n    #vertical-after {\n      display: inline-grid;\n      grid-template-rows: auto 0 minmax(auto, var(--splitter4-height));\n      width: 100px;\n      height: 500px;\n      --splitter4-height: 200px;\n    }\n\n    #vertical-splitters {\n      display: flex;\n      position: absolute;\n      top: 0;\n      left: 520px;\n    }\n\n    .resized,\n    .fill2 {\n      background-color: lightblue;\n    }\n\n    .fill {\n      background-color: lightslategrey;\n    }\n\n    #window-resize-splitter-vertical {\n      display: grid;\n      --splitter6-height: 400px;\n      grid-template-rows: auto min-content minmax(auto, var(--splitter6-height));\n      height: 80vh;\n      width: 100px;\n      position: absolute;\n      top: 0;\n      right: 0;\n      pointer-events: none;\n    }\n\n    #window-resize-splitter {\n      display: grid;\n      --splitter5-width: 200px;\n      --splitter5-2-width: 200px;\n      grid-template-columns:  minmax(auto, var(--splitter5-width)) min-content minmax(auto, 1fr) min-content minmax(auto, var(--splitter5-2-width));\n      width: 90vw;\n      height: 100px;\n      position: absolute;\n      top: 220px;\n      left: 0;\n      pointer-events: none;\n    }\n\n    #resizeSplitter-before {\n      min-width: 120px;\n    }\n\n    #resizeSplitter-after {\n      min-width: 160px;\n    }\n\n    #resizeSplitter-vertical-before {\n      min-height: 120px;\n    }\n  </style>\n  <!-- This path is used for the automated test. -->\n  <script src=\"chrome://messenger/content/pane-splitter.js\"></script>\n  <!-- This path is used when this file is loaded in a browser. -->\n  <script src=\"../../../content/widgets/pane-splitter.js\"></script>\n  <script>\n    function moveMarker(event) {\n      let markerX = document.getElementById(\"markerX\");\n      markerX.style.left = `${event.clientX + window.scrollX}px`;\n      markerX.textContent = `${event.type} event here`;\n\n      let markerY = document.getElementById(\"markerY\");\n      markerY.style.top = `${event.clientY + window.scrollY}px`;\n      markerY.textContent = `${event.type} event here`;\n    }\n\n    document.addEventListener(\"mousedown\", moveMarker);\n    document.addEventListener(\"mousemove\", moveMarker);\n    document.addEventListener(\"mouseup\", moveMarker);\n\n    window.addEventListener(\"load\", () => {\n      for (let splitter of document.querySelectorAll('hr[is=\"pane-splitter\"]')) {\n        if (splitter.hasAttribute(\"resize-id\")) {\n          splitter.resizeElement;\n          continue;\n        }\n\n        const element = splitter.parentNode.querySelector(\".resized\");\n        if (element) {\n          splitter.resizeElement = element;\n        }\n      }\n    });\n  </script>\n</head>\n<body>\n  <div id=\"horizontal-before\">\n    <div id=\"splitter1-before\" class=\"resized\"></div>\n    <hr is=\"pane-splitter\" id=\"splitter1\" resize-direction=\"horizontal\" />\n    <div id=\"splitter1-after\" class=\"fill\"></div>\n  </div>\n\n  <div id=\"horizontal-after\">\n    <div id=\"splitter2-before\" class=\"fill\"></div>\n    <hr is=\"pane-splitter\" id=\"splitter2\" resize=\"next\" resize-direction=\"horizontal\" />\n    <div id=\"splitter2-after\" class=\"resized\"></div>\n  </div>\n\n  <div id=\"vertical-splitters\">\n    <div id=\"vertical-before\">\n      <div id=\"splitter3-before\" class=\"resized\"></div>\n      <hr is=\"pane-splitter\" id=\"splitter3\" />\n      <div id=\"splitter3-after\" class=\"fill\"></div>\n    </div>\n\n    <div id=\"vertical-after\">\n      <div id=\"splitter4-before\" class=\"fill\"></div>\n      <hr is=\"pane-splitter\" id=\"splitter4\" resize=\"next\" />\n      <div id=\"splitter4-after\" class=\"resized\"></div>\n    </div>\n  </div>\n\n  <div id=\"window-resize-splitter\">\n    <div id=\"resizeSplitter-before\" class=\"fill2\"></div>\n    <hr\n      is=\"pane-splitter\"\n      id=\"splitter5\"\n      resize-id=\"resizeSplitter-before\"\n      resize-direction=\"horizontal\"/>\n    <div id=\"resizeSplitter-after\" class=\"fill\"></div>\n    <hr\n      is=\"pane-splitter\"\n      id=\"splitter5-2\"\n      resize-id=\"resizeSplitter-after2\"\n      resize-direction=\"horizontal\"\n      resize-lock-ids=\"resizeSplitter-after,resizeSplitter-before\"\n      resize-with-window=\"true\"/>\n    <div id=\"resizeSplitter-after2\" class=\"fill2\"></div>\n  </div>\n\n  <div id=\"window-resize-splitter-vertical\">\n    <div id=\"resizeSplitter-vertical-before\" class=\"fill\"></div>\n    <hr\n      is=\"pane-splitter\"\n      id=\"splitter6\"\n      resize-id=\"resizeSplitter-vertical-after\"\n      resize-direction=\"vertical\"\n      resize-lock-ids=\"resizeSplitter-vertical-before\"\n      resize-with-window=\"true\"/>\n    <div id=\"resizeSplitter-vertical-after\" class=\"fill2\"></div>\n  </div>\n\n  <div id=\"self-resize-splitter\">\n    <hr\n      is=\"pane-splitter\"\n      id=\"splitter7\"\n      resize-id=\"self-resize-splitter\"\n      resize-direction=\"horizontal\"/>\n  </div>\n\n  <div id=\"markerX\" style=\"position: absolute; top: 0px; border-left: 1px red solid;\"></div>\n  <div id=\"markerY\" style=\"position: absolute; left: 550px; border-top: 1px red solid;\"></div>\n</body>\n</html>","title":"History 4238–4246 accepted source: mail/base/test/browser/widgets/files/paneSplitter.xhtml:1","version":1,"visibility":"shared"}
