                     alt=\"\" />\n+            <label class=\"category-name\" flex=\"1\" data-l10n-id=\"pane-qr-export-title\"/>\n+          </richlistitem>\n         </richlistbox>\n \n         <spacer flex=\"1\"/>\n@@ -212,6 +222,7 @@\n #ifdef NIGHTLY_BUILD\n #include sync.inc.xhtml\n #endif\n+#include qrExport.inc.xhtml\n           </vbox>\n         </vbox>\n       </vbox>\ndiff --git a/mail/components/preferences/qrExport.inc.xhtml b/mail/components/preferences/qrExport.inc.xhtml\nnew file mode 100644\nindex 00000000000..84b64fbe966\n--- /dev/null\n+++ b/mail/components/preferences/qrExport.inc.xhtml\n@@ -0,0 +1,38 @@\n+# This Source Code Form is subject to the terms of the Mozilla Public\n+# License, v. 2.0. If a copy of the MPL was not distributed with this\n+# file, You can obtain one at http://mozilla.org/MPL/2.0/.\n+<html:template id=\"paneQrExport\" xmlns=\"http://www.w3.org/1999/xhtml\">\n+  <div\n+    id=\"qrExportPaneCategory\"\n+    class=\"subcategory\"\n+    data-category=\"paneQrExport\"\n+  >\n+    <h1 data-l10n-id=\"qr-export-pane-header\"></h1>\n+    <section id=\"qrExportIntro\">\n+      <p data-l10n-id=\"qr-export-description\"></p>\n+      <p\n+        class=\"qr-small\"\n+        data-l10n-id=\"qr-export-get-app\"\n+      >\n+        <a\n+          data-l10n-name=\"app-link\"\n+          href=\"https://play.google.com/store/apps/details?id=net.thunderbird.android.beta&amp;utm_source=thunderbird-desktop&amp;utm_campaign=cross-device-import\"\n+        ></a>\n+      </p>\n+      <h2 data-l10n-id=\"qr-export-create\"></h2>\n+      <form id=\"qrExportIntroForm\" class=\"qr-panel\" action=\"\">\n+        <h3 data-l10n-id=\"qr-export-select-accounts\"></h3>\n+        <p\n+          id=\"qrExportNoAccounts\"\n+          data-l10n-id=\"qr-export-no-accounts\"\n+          class=\"qr-small\"\n+        >\n+          <a\n+            data-l10n-name=\"account-support-link\"\n+            href=\"https://support.thunderbird.net/kb/thunderbird-android-import\"\n+          ></a>\n+        </p>\n+      </form>\n+    </section>\n+  </div>\n+</html:template>\ndiff --git a/mail/components/preferences/qrExport.mjs b/mail/components/preferences/qrExport.mjs\nnew file mode 100644\nindex 00000000000..d2eaf90aec2\n--- /dev/null\n+++ b/mail/components/preferences/qrExport.mjs\n@@ -0,0 +1,9 @@\n+/* This Source Code Form is subject to the terms of the Mozilla Public\n+ * License, v. 2.0. If a copy of the MPL was not distributed with this\n+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */\n+\n+export const qrExportPane = {\n+  init() {\n+    document.getElementById(\"qrExportIntro\").hidden = false;\n+  },\n+};\ndiff --git a/mail/components/preferences/test/browser/browser.ini b/mail/components/preferences/test/browser/browser.ini\nindex 44b7d97a312..eced36a0458 100644\n--- a/mail/components/preferences/test/browser/browser.ini\n+++ b/mail/components/preferences/test/browser/browser.ini\n@@ -15,6 +15,7 @@ support-files = files/icon.svg files/management.html\n [browser_general.js]\n [browser_openPreferences.js]\n [browser_privacy.js]\n+[browser_qrExport.js]\n [browser_sync.js]\n skip-if = !nightly_build\n support-files = files/avatar.png\ndiff --git a/mail/components/preferences/test/browser/browser_qrExport.js b/mail/components/preferences/test/browser/browser_qrExport.js\nnew file mode 100644\nindex 00000000000..7e47234fbaa\n--- /dev/null\n+++ b/mail/components/preferences/test/browser/browser_qrExport.js\n@@ -0,0 +1,19 @@\n+/* This Source Code Form is subject to the terms of the Mozilla Public\n+ * License, v. 2.0. If a copy of the MPL was not distributed with this\n+ * file, you can obtain one at http://mozilla.org/MPL/2.0/. */\n+\n+\"use strict\";\n+\n+let prefsWindow, prefsDocument, tabmail;\n+\n+add_setup(async function () {\n+  ({ prefsWindow, prefsDocument } = await openNewPrefsTab(\"paneQrExport\"));\n+  tabmail = document.getElementById(\"tabmail\");\n+});\n+\n+add_task(async function test_init() {\n+  Assert.ok(\n+    BrowserTestUtils.isVisible(prefsDocument.getElementById(\"qrExportIntro\")),\n+    \"Intro screen should be visible by default\"\n+  );\n+});\ndiff --git a/mail/locales/en-US/messenger/preferences/preferences.ftl b/mail/locales/en-US/messenger/preferences/preferences.ftl\nindex baedb7d5cae..6cd81af5f98 100644\n--- a/mail/locales/en-US/messenger/preferences/preferences.ftl\n+++ b/mail/locales/en-US/messenger/preferences/preferences.ftl\n@@ -34,6 +34,10 @@ pane-sync-title = Sync\n category-sync =\n     .tooltiptext = Sync\n \n+pane-qr-export-title = Export for Mobile\n+category-qr-export =\n+    .tooltiptext = Export for Mobile\n+\n general-language-and-appearance-header = Language & Appearance\n \n general-incoming-mail-header = Incoming Mails\n@@ -1062,3 +1066,31 @@ synced-acount-item-keys = OpenPGP - S/MIME\n sync-disconnected-text = Synchronize your email accounts, address books, calendars, and identities across all your devices.\n \n sync-disconnected-turn-on-sync = Turn on Syncing…\n+\n+## Mobile QR Export Pane\n+\n+qr-export-pane-header = Export accounts to { -brand-product-name } Mobile\n+\n+qr-export-description = Quickly transfer your account settings from desktop to mobile by generating a QR code. Select which accounts to include, decide if you want to transfer your password, and scan the code with your mobile device. Fast, secure, and simple.\n+\n+qr-export-get-app = Don’t have { -brand-product-name } on mobile yet? <a data-l10n-name=\"app-link\">Get it on Google Play</a>\n+\n+qr-export-create = Create a QR code to export your accounts\n+\n+qr-export-select-accounts = Select which accounts to export:\n+\n+qr-export-no-accounts = Not seeing all your accounts? Some accounts may be disabled because they are not supported by { -brand-product-name } for Android. <a data-l10n-name=\"account-support-link\">Support</a>\n+\n+qr-export-accounts-legend = Email accounts\n+\n+qr-export-select-all-accounts = Select all\n+\n+qr-export-security-legend = Security\n+\n+qr-export-include-passwords = Include all accounts passwords\n+\n+qr-export-security-hint = By scanning the following QR codes, your account settings—including your email and password—will be transferred securely. We do not collect, store, or share any of this data during the process. The transfer occurs directly between your devices.\n+\n+qr-export-security-warning = For your security, please ensure you are in a private setting and only scan QR codes from trusted sources.\n+\n+qr-export-start-export = Export\ndiff --git a/mail/themes/shared/jar.inc.mn b/mail/themes/shared/jar.inc.mn\nindex 6eefcfe39c9..756abaf5196 100644\n--- a/mail/themes/shared/jar.inc.mn\n+++ b/mail/themes/shared/jar.inc.mn\n@@ -755,4 +755,7 @@\n   skin/classic/messenger/icons/sm/folder-compact.svg           (../shared/mail/icons/sm/folder-compact.svg)\n   skin/classic/messenger/icons/sm/sparkle-star.svg             (../shared/mail/icons/sm/sparkle-star.svg)\n \n+# LG - 24x24px icons\n+  skin/classic/messenger/icons/lg/upload.svg                   (../shared/mail/icons/lg/upload.svg)\n+\n   skin/classic/messenger/icons/brand/nebula-logo.webp          (../shared/mail/icons/brand/nebula-logo.webp)\ndiff --git a/mail/themes/shared/mail/icons/lg/upload.svg b/mail/themes/shared/mail/icons/lg/upload.svg\nnew file mode 100644\nindex 00000000000..688dfc6ea84\n--- /dev/null\n+++ b/mail/themes/shared/mail/icons/lg/upload.svg\n@@ -0,0 +1,6 @@\n+<!-- This Source Code Form is subject to the terms of the Mozilla Public\n+   - License, v. 2.0. If a copy of the MPL was not distributed with this\n+   - file, You can obtain one at http://mozilla.org/MPL/2.0/. -->\n+<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n+  <path d=\"M11.5 16C11.2239 16 11 15.7761 11 15.5V5.70711L6.85355 9.85355C6.65829 10.0488 6.34171 10.0488 6.14645 9.85355C5.95118 9.65829 5.95118 9.34171 6.14645 9.14645L11.1465 4.14645C11.3417 3.95118 11.6583 3.95118 11.8535 4.14645L16.8536 9.14645C17