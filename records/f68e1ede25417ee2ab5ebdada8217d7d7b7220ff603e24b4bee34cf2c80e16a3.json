ader\" class=\"branding-header\" hidden=\"hidden\">\n      <img src=\"chrome://branding/content/logo-gradient.svg\" alt=\"\" />\n      <h1 class=\"account-hub-title\">\n        <span class=\"branding-header-name\" aria-hidden=\"hidden\"></span>\n        <span class=\"branding-header-title\" aria-hidden=\"hidden\"></span>\n        <span\n          class=\"account-hub-welcome-text screen-reader-only\"\n          data-l10n-id=\"account-hub-welcome-text\"\n        ></span>\n      </h1>\n    </div>\n    <!-- Title Text for Email Setup -->\n    <h1 id=\"accountHubHeaderTitle\"\n        class=\"sub-view-title\">\n        <slot name=\"title\"></slot>\n    </h1>\n    <h2 id=\"accountHubHeaderSubheader\"\n        class=\"sub-view-sub-header\"\n        hidden=\"hidden\">\n        <slot name=\"subheader\"></slot>\n    </h2>","title":"History 5753–5757 accepted source: mail/components/accountcreation/templates/accountHubHeaderTemplate.inc.xhtml:5","version":1,"visibility":"shared"}
