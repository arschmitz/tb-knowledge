                value=\"3\"\n                      hidden=\"hidden\">Exchange</option>\n              <option id=\"incomingProtocolEWS\"\n                      value=\"4\">EWS</option>\n              <option id=\"incomingProtocolGraph\"\n                      value=\"5\" >Graph</option>\n          </account-hub-select>\n        </div>\n        <div id=\"incomingHostnameFormGroup\" class=\"expanded\">\n          <label for=\"incomingHostname\"\n                 data-l10n-id=\"account-hub-result-hostname-label\"\n                 class=\"option-label\">\n          </label>\n          <div class=\"input-control\">\n            <input id=\"incomingHostname\"\n                   type=\"text\"\n                   placeholder=\"mail.example.com\"\n                   required=\"required\"\n                   class=\"input-field manual-input\"\n                   aria-invalid=\"false\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-danger input-warning\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-success input-success\" />\n            <span id=\"incomingHostnameErrorMessage\"\n                  class=\"input-error-message\"\n                  data-l10n-id=\"account-hub-hostname-error-text\">\n            </span>\n          </div>\n        </div>\n\n        <div id=\"incomingExchangeUrlFormGroup\" class=\"expanded\" hidden=\"hidden\">\n          <label for=\"incomingExchangeUrl\"\n                 data-l10n-id=\"account-hub-result-exchange-url-label\"\n                 class=\"option-label\">\n          </label>\n          <div class=\"input-control\">\n            <input id=\"incomingExchangeUrl\"\n                   type=\"url\"\n                   placeholder=\"https://www.example.com/\"\n                   required=\"required\"\n                   class=\"input-field manual-input\"\n                   aria-invalid=\"false\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-danger input-warning\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-success input-success\" />\n            <span id=\"incomingEwsUrlErrorMessage\"\n                  class=\"input-error-message\"\n                  data-l10n-id=\"account-hub-server-error-text\">\n            </span>\n          </div>\n        </div>\n      </div>\n      <div id=\"nonEwsFormRow\" class=\"form-row\">\n        <div>\n          <label for=\"incomingPort\"\n                 data-l10n-id=\"account-hub-on-port-label\"\n                 class=\"option-label\">\n          </label>\n          <div class=\"input-control\">\n            <input id=\"incomingPort\"\n                   type=\"number\"\n                   min=\"1\"\n                   max=\"65535\"\n                   placeholder=\"993\"\n                   required=\"required\"\n                   class=\"input-field number-input\"\n                   aria-invalid=\"false\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-danger input-warning\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-success input-success\" />\n            <span id=\"incomingPortErrorMessage\"\n                  class=\"input-error-message\"\n                  data-l10n-id=\"account-hub-port-error-text\">\n            </span>\n          </div>\n        </div>\n\n        <div class=\"expanded\">\n          <account-hub-select id=\"incomingConnectionSecurity\"\n                  l10n-label-id=\"account-hub-ssl-label\"\n                  l10n-error-id=\"account-hub-select-security-warning\"\n                  flex=\"1\">\n              <option id=\"incomingConnectionSecurityAutodetect\"\n                      data-l10n-id=\"account-hub-ssl-autodetect-option\"\n                      value=\"-1\"></option>\n              <option id=\"incomingConnectionSecurityNoEncryption\"\n                      selected=\"true\"\n                      data-l10n-id=\"account-hub-ssl-noencryption-option\"\n                      value=\"0\"></option>\n              <option id=\"incomingConnectionSecurityStartTtls\"\n                      label=\"STARTTLS\"\n                      value=\"2\"></option>\n              <option id=\"incomingConnectionSecuritySslTls\"\n                      label=\"SSL/TLS\"\n                      value=\"3\"></option>\n          </account-hub-select>\n        </div>\n      </div>\n      <div class=\"form-row responsive-row\">\n        <div>\n          <account-hub-select id=\"incomingAuthMethod\"\n                  l10n-label-id=\"account-hub-auth-label\"\n                  required=\"required\"\n                  value=\"0\"\n                  flex=\"1\">\n            <option id=\"incomingAuthMethodAutodetect\"\n                    data-l10n-id=\"account-hub-ssl-autodetect-option\"\n                    value=\"0\">\n            </option>\n            <option id=\"incomingAuthMethodCleartext\"\n                    data-l10n-id=\"account-hub-ssl-cleartext-password-option\"\n                    value=\"3\">\n            </option>\n            <option id=\"incomingAuthMethodEncrypted\"\n                    data-l10n-id=\"account-hub-ssl-encrypted-password-option\"\n                    value=\"4\">\n            </option>\n            <option id=\"incomingAuthMethodKerbos\"\n                    label=\"Kerberos / GSSAPI\"\n                    value=\"5\">\n            </option>\n            <option id=\"incomingAuthMethodNtlm\"\n                    label=\"NTLM\"\n                    value=\"6\">\n            </option>\n            <option id=\"incomingAuthMethodOAuth2\"\n                    value=\"10\"\n                    hidden=\"hidden\"\n                    label=\"OAuth2\">\n            </option>\n          </account-hub-select>\n        </div>\n\n        <div class=\"expanded\">\n          <label for=\"incomingUsername\"\n                 data-l10n-id=\"account-hub-result-username-label\"\n                 class=\"option-label\">\n          </label>\n          <div class=\"input-control\">\n            <input id=\"incomingUsername\"\n                   type=\"text\"\n                   data-l10n-id=\"account-hub-email-input\"\n                   required=\"required\"\n                   class=\"username input-field manual-input\"\n                   aria-invalid=\"false\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-danger input-warning\" />\n            <img src=\"\"\n                 alt=\"\"\n                 class=\"form-icon icon-success input-success\" />\n            <span id=\"incomingUsernameErrorMessage\"\n                  class=\"input-error-message\"\n                  data-l10n-id=\"account-hub-username-error-text\">\n            </span>\n          </div>\n        </div>\n      </div>\n      <button id=\"advancedConfigurationIncoming\"\n              class=\"button link-button link-button-sm align-self-end\"\n              type=\"button\"\n              data-l10n-id=\"account-hub-advanced-setup-button\">\n      </button>\n    </div>\n    <button type=\"submit\" hidden=\"hidden\"></button>\n  </form>\n</html:template>","title":"History 1218–1247 accepted source: mail/components/accountcreation/templates/accountHubEmailIncomingFormTemplate.inc.xhtml:1","version":1,"visibility":"shared"}
