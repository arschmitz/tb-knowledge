onfig-item-icon\" src=\"chrome://messenger/skin/icons/new/compact/account-settings.svg\" alt=\"\" />\n                  <div class=\"config-item-data\">\n                    <p class=\"title\" data-l10n-id=\"account-hub-servers-username-label\"></p>\n                    <p id=\"outgoingUsername\" class=\"data\"></p>\n                  </div>\n                </div>\n\n                <!-- Authentication type -->\n                <div class=\"config-detail shared-config-item\">\n                  <img class=\"config-item-icon\" src=\"chrome://messenger/skin/icons/new/compact/key.svg\" alt=\"\" />\n                  <div class=\"config-item-data\">\n                    <p class=\"title\" data-l10n-id=\"account-hub-result-authentication-type-label\"></p>\n                    <p id=\"outgoingAuthenticationType\" class=\"data\"></p>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"config-common\">\n              <div id=\"allServersHeading\" class=\"config-header\">\n                <h3 class=\"header-title\" data-l10n-id=\"account-hub-all-servers-legend\"></h3>\n              </div>\n\n              <!-- Username -->\n              <div class=\"config-detail\">\n                <img class=\"config-item-icon\" src=\"chrome://messenger/skin/icons/new/compact/account-settings.svg\" alt=\"\" />\n                <div class=\"config-item-data\">\n                  <p class=\"title\" data-l10n-id=\"account-hub-servers-username-label\"></p>\n                  <p id=\"sharedUsername\" class=\"data\"></p>\n                </div>\n              </div>\n\n              <div class=\"config-row\">\n                <!-- Connection security -->\n                <div class=\"config-detail\">\n                  <img class=\"config-item-icon\" src=\"chrome://messenger/skin/icons/new/compact/shield.svg\" alt=\"\" />\n                  <div class=\"config-item-data\">\n                    <p class=\"title\" data-l10n-id=\"account-hub-result-security-label\"></p>\n                    <p id=\"sharedSocketType\" class=\"data\"></p>\n                  </div>\n                </div>\n\n                <!-- Authentication type -->\n                <div class=\"config-detail\">\n                  <img class=\"config-item-icon\" src=\"chrome://messenger/skin/icons/new/compact/key.svg\" alt=\"\" />\n                  <div class=\"config-item-data\">\n                    <p class=\"title\" data-l10n-id=\"account-hub-result-authentication-type-label\"></p>\n                    <p id=\"sharedAuthenticationType\" class=\"data\"></p>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"custom-action-container\">\n              <button id=\"editConfiguration\"\n                      class=\"button link-button link-button-sm\"\n                      type=\"button\"\n                      data-l10n-id=\"account-hub-edit-configuration\">\n              </button>\n            </div>\n\n#ifndef MOZ_ENTERPRISE\n            <!-- Install Add-on Text -->\n            <div id=\"owlExchangeDescription\" class=\"owl-exchange-section\" hidden=\"hidden\">\n              <p>\n                <img id=\"addonIcon\" class=\"addon-icon\" />\n                <a id=\"addonInfo\" class=\"addon-info link\"></a>\n              </p>\n              <button id=\"addonInstall\"\n                      class=\"install-addon-button button button-sm primary-button\"\n                      type=\"button\"\n                      data-l10n-id=\"account-hub-addon-install-title\">\n              </button>\n            </div>\n#endif\n\n          </div>\n        </div>\n      </div>\n      <button type=\"submit\" hidden=\"hidden\"></button>\n    </form>\n  </div>\n</html:template>","title":"History 1698–1727 accepted source: mail/components/accountcreation/templates/accountHubEmailConfigFoundTemplate.inc.xhtml:1","version":1,"visibility":"shared"}
