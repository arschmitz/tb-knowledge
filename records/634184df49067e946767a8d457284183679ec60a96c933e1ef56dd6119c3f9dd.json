iv class=\"config-text\" data-l10n-id=\"account-hub-result-imap-description\"></div>\n            </label>\n\n            <label id=\"pop3\" class=\"config-option\">\n              <div class=\"config-title\">\n                <input type=\"radio\" name=\"config-type\" value=\"pop3\" />\n                <span class=\"config-title-text\">POP3</span>\n                <span\n                  class=\"badge\"\n                  role=\"presentation\"\n                  data-l10n-id=\"account-hub-result-recommended-label\"\n                ></span>\n              </div>\n              <div class=\"config-text\" data-l10n-id=\"account-hub-result-pop-description\"></div>\n            </label>\n\n            <label id=\"ews\" class=\"config-option\" hidden=\"hidden\">\n              <div class=\"config-title\">\n                <input type=\"radio\" name=\"config-type\" value=\"ews\" />\n                <span class=\"config-title-text\" data-l10n-id=\"account-hub-result-ews-shortname\"></span>\n                <span\n                  class=\"badge\"\n                  role=\"presentation\"\n                  data-l10n-id=\"account-hub-result-recommended-label\"\n                ></span>\n              </div>\n              <div class=\"config-text\" data-l10n-id=\"account-hub-result-ews-description\"></div>\n            </label>\n\n            <label id=\"graph\" class=\"config-option\" hidden=\"hidden\">\n              <div class=\"config-title\">\n                <input type=\"radio\" name=\"config-type\" value=\"graph\" />\n                <span class=\"config-title-text\" data-l10n-id=\"account-hub-result-graph-api-shortname\"></span>\n                <span\n                  class=\"badge\"\n                  role=\"presentation\"\n                  data-l10n-id=\"account-hub-result-recommended-label\"\n                ></span>\n              </div>\n              <div class=\"config-text\" data-l10n-id=\"account-hub-result-graph-api-description\"></div>\n            <