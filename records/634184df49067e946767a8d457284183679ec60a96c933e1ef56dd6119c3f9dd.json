enger/skin/icons/new/compact/conversation.svg\" alt=\"\" />\n                  <div class=\"config-item-data\">\n                    <p class=\"title\" data-l10n-id=\"account-hub-result-port-label\"></p>\n                    <p id=\"incomingPort\" class=\"data\"></p>\n                  </div>\n                </div>\n\n                <!-- Connection security -->\n                <div class=\"config-detail shared-config-item\">\n                  <img class=\"config-item-icon\" src=\"chrome://messenger/skin/icons/new/compact/shield.svg\" alt=\"\" />\n                  <div class=\"config-item-data\">\n                    <p class=\"title\" data-l10n-id=\"account-hub-result-security-label\"></p>\n                    <p id=\"incomingSocketType\" class=\"data\"></p>\n                  </div>\n                </div>\n\n                <!-- Username -->\n                <div class=\"config-detail shared-config-item\">\n                  <img class=\"config-item-icon\" src=\"chrome://messenger/skin/icons/new/compact/account-settings.svg\" alt=\"\" />\n                  <div class=\"config-item-data\">\n                    <p class=\"title\" data-l10n-id=\"account-hub-servers-username-label\"></p>\n                    <p id=\"incomingUsername\" class=\"data\"></p>\n                  </div>\n                </div>\n\n                <!-- Authentication type -->\n                <div class=\"config-detail shared-config-item\">\n                  <img class=\"config-item-icon\" src=\"chrome://messenger/skin/icons/new/compact/key.svg\" alt=\"\" />\n                  <div class=\"config-item-data\">\n                    <p class=\"title\" data-l10n-id=\"account-hub-result-authentication-type-label\"></p>\n                    <p id=\"incomingAuthenticationType\" class=\"data\"></p>\n                  </div>\n                </div>\n              </div>\n\n              <div id=\"outgoingConfig\" class=\"config-column\" hidden=\"hidden\">\n                <div id=\"outgoingConfig